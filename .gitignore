docs/build/
docs/site/
docs/clones/
docs/out/
docs/src/generated/

docs/src/assets/

# Build artifact for using README as index

# Manifests: track main package Manifest for reproducibility, ignore docs Manifest
docs/Manifest.toml

# Sysimage (PackageCompiler)
QLDPC.so
*.so
*.dylib

